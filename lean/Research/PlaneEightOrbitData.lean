import Research.PlaneOrbitData

namespace PlaneResearch.EightOrbit
open PlaneResearch.SevenOrbit (Set13 l0 l1)
private def packed : ℕ := 
def sA : Set13 := {0,1,2,3,4,5,6,7}
def sB : Set13 := {0,1,2,3,4,5,7,8}
def sC : Set13 := {0,1,2,3,4,6,9,10}
def rank (s : Set13) : ℕ := (packed >>> (4 * ∑ i ∈ s, 2^i.val)) % 16
abbrev Step (s : Set13) := s=sA ∨ s=sB ∨ s=sC ∨
  rank (s.image l0) < rank s ∨ rank (s.image l1) < rank s
set_option maxRecDepth 50000 in
set_option maxHeartbeats 12000000 in
private theorem checked : ((Finset.univ : Set13).powersetCard 8).filter (fun s => ¬ Step s) = ∅ := by
  decide +kernel

theorem step (s : Set13) (eight : s.card=8) : Step s := by
  by_contra h
  have bad : s ∈ ((Finset.univ : Set13).powersetCard 8).filter (fun t => ¬ Step t) :=
    Finset.mem_filter.mpr ⟨Finset.mem_powersetCard.mpr ⟨Finset.subset_univ _,eight⟩,h⟩
  rw [checked] at bad
  exact Finset.notMem_empty _ bad

end PlaneResearch.EightOrbit
