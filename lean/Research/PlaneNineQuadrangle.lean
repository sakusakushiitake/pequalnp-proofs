import Research.PlaneSixTriples
import Research.PlaneSevenOrbit

namespace PlaneResearch.NineQuadrangle
open PEqualNP.CircuitLowerBounds PEqualNP.MetaComplexity PlaneResearch.Projection
open PlaneResearch.PlaneOrderThree (lines)
open PlaneResearch.SevenOrbit (Points Set13 Lower transfer l0 l1 undo0 undo1 image0 image1)

/-- No three omitted lines pass through one point. -/
def NoThree (s : Set13) : Prop := ∀ p : Points, ((Finset.univ \ s).filter (fun i => p ∈ lines i)).card ≤ 2
instance (s : Set13) : Decidable (NoThree s) := inferInstanceAs (Decidable (∀ p : Points, _))
private def seed : Set13 := {0,1,2,3,4,5,6,7,11}
private def packed : ℕ := 
private def rank (s : Set13) : ℕ := (packed >>> (4*∑ i ∈ s, 2^i.val)) % 16
private abbrev Step (s : Set13) := s=seed ∨
  (NoThree (s.image l0) ∧ rank (s.image l0)<rank s) ∨
  (NoThree (s.image l1) ∧ rank (s.image l1)<rank s)
set_option maxRecDepth 50000
set_option maxHeartbeats 12000000

theorem number_of_selections : (((Finset.univ : Set13).powersetCard 9).filter NoThree).card = 234 := by decide +kernel
private theorem checked : (((Finset.univ : Set13).powersetCard 9).filter NoThree).filter (fun s => ¬Step s) = ∅ := by decide +kernel
private lemma step (s : Set13) (nine : s.card=9) (geo : NoThree s) : Step s := by
  by_contra h
  have bad : s ∈ (((Finset.univ : Set13).powersetCard 9).filter NoThree).filter (fun t => ¬Step t) :=
    Finset.mem_filter.mpr ⟨Finset.mem_filter.mpr ⟨Finset.mem_powersetCard.mpr ⟨Finset.subset_univ _,nine⟩,geo⟩,h⟩
  rw [checked] at bad
  exact Finset.notMem_empty _ bad
private lemma representative : Lower seed 27 := by
  intro C o ok hc
  apply PlaneResearch.PlaneSixTriples.nine234.lower C (fun i => o (PlaneResearch.PlaneSixTriples.nine234.labels i)) ok
  exact fun i => hc _ ((by decide +kernel : ∀ i, PlaneResearch.PlaneSixTriples.nine234.labels i ∈ seed) i)

theorem nine_sets (s : Set13) (nine : s.card=9) (geo : NoThree s) : Lower s 27 := by
  suffices h : ∀ n (t : Set13), rank t=n → t.card=9 → NoThree t → Lower t 27 from h _ s rfl nine geo
  intro n
  induction n using Nat.strong_induction_on with
  | ind n ih =>
    intro t eq card good
    have non : t.Nonempty := Finset.card_pos.mp (by omega)
    rcases step t card good with rfl|⟨g0,h0⟩|⟨g1,h1⟩
    · exact representative
    · apply transfer t non _ _ _ undo0 image0
      have inj : Function.Injective l0 := Function.LeftInverse.injective undo0
      exact ih _ (eq ▸ h0) _ rfl (by simpa [Finset.card_image_of_injective _ inj] using card) g0
    · apply transfer t non _ _ _ undo1 image1
      have inj : Function.Injective l1 := Function.LeftInverse.injective undo1
      exact ih _ (eq ▸ h1) _ rfl (by simpa [Finset.card_image_of_injective _ inj] using card) g1

end PlaneResearch.NineQuadrangle
