theorem size : C.size=64 := by decide +kernel
theorem monotone : Monotone2 C := monotone_checked C (by decide +kernel)
private theorem checked : ∀ k : Fin C.gates.length,
    checkGate certificate k.val (C.gates.get k)=true := by decide +kernel
private theorem final_terms : same (atWire certificate C.output) (edgeTerms E)=true := by decide +kernel
theorem correct (x : V → Bool) : C.eval (List.ofFn x)=true ↔
    ∃ p q, (p,q) ∈ E ∧ x p=true ∧ x q=true :=
  (wire C certificate checked x C.output (by decide +kernel)).trans ((equiv final_terms x).trans (edges E x))

private theorem source_graph : ∀ a b : V, (a,b) ∈ E ↔ (a,b) ∈ PlaneClean.edges := by decide +kernel
private def andCheck (op : GateOp) (v : Bool) : Bool := match op with | .and => v | _ => true
private theorem safe : ∀ k : Fin C.gates.length, andCheck (C.gates.get k).op
    (impliesD (atWire certificate (26+k.val)) (edgeTerms E))=true := by decide +kernel
theorem clean : PlaneResearch.CleanWireModel.PairClean PlaneClean.graph C := by
  intro k hk op p q on'
  have active := (wire C certificate checked (pair p q) (26+k) (by omega)).mp on'
  have good := safe ⟨k,hk⟩
  change andCheck C.gates[k].op (impliesD (atWire certificate (26+k)) (edgeTerms E))=true at good
  rw [op] at good
  have eval := (edges E _).mp (entails good active)
  obtain ⟨a,b,edge,ha,hb⟩ := eval
  have adj : PlaneClean.graph.Adj a b := Or.inl ((source_graph a b).mp edge)
  rcases (of_decide_eq_true ha : a=p ∨ a=q) with rfl|rfl <;>
    rcases (of_decide_eq_true hb : b=_ ∨ b=_) with e|e <;> subst b
  · exact (PlaneClean.graph.loopless.irrefl _ adj).elim
  · exact adj
  · exact adj.symm
  · exact (PlaneClean.graph.loopless.irrefl _ adj).elim

